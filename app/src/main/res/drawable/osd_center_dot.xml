<?xml version="1.0" encoding="utf-8"?>
<!-- Red dot with a dark rim, so it stays visible on bright backgrounds. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFF2A2A" />
    <stroke
        android:width="1dp"
        android:color="#99000000" />
    <size
        android:width="8dp"
        android:height="8dp" />
</shape>
